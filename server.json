{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.limzo/telegram-group-stats",
  "title": "Limzo Telegram Group Stats",
  "description": "Read-only stats for public Telegram groups tracked by Limzo, the anti-spam bot. No API key.",
  "websiteUrl": "https://limzo.com/docs/",
  "repository": {
    "url": "https://github.com/LimzoCom/limzo-mcp",
    "source": "github"
  },
  "version": "1.3.1",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "limzo-mcp",
      "version": "1.3.1",
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://limzo.com/api/public/mcp"
    }
  ]
}
